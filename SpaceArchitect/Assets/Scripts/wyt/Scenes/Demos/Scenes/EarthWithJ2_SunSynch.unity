  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 0.19607843, g: 0.19607843, b: 0.19607843, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 14
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "Sun Synchronous Orbit\nThe oblateness of the Earth results in a precession\nof
    the ascending node. If the inclination and radius are \"just so\" an orbit which
    precessess 360 degress in a year can be created. This ensures that the sun makes
    the same angle with the Earth on every orbit. Note the J2Force details attached
    to the Earth game object.\n\nThis can be modelled in GE with a J2Force model
    or by using the PKEPLER_J2  propagator. (SGP4 also models this as well as other
    perturbations from drag, sun and moon).\n\nThis scene includes one example of
    NBody with J2 and one of PKEPLER. \n\nThis scene uses ORBITAL units.\n\nTo compare
    with spherical gravity change one of the satellites to use Kepler mode. "
